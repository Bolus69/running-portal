# Public Supabase values. Safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never add these to NEXT_PUBLIC_* variables or commit real values.
SUPABASE_SECRET_KEY=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_TOKEN_ENCRYPTION_KEY=
STRAVA_WEBHOOK_SECRET=

# Optional canonical URL used by OAuth callback links.
NEXT_PUBLIC_APP_URL=
